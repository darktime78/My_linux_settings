##
# Variables
##

set $mod Mod4

# Plain names. The icons are added by waybar (sway/workspaces in waybar.conf):
# Pango markup inside a workspace name is shown by waybar as raw text.
set $wspace1  "1"
set $wspace2  "2"
set $wspace3  "3"
set $wspace4  "4"
set $wspace5  "5"
set $wspace6  "6"
set $wspace7  "7"
set $wspace8  "8"
set $wspace9  "9"
set $wspace10 "10"

set $bg-color            #2f343f
set $inactive-bg-color   #2f343f
set $text-color          #f3f4f5
set $inactive-text-color #676E7D
set $urgent-bg-color     #E53935
set $text-color          #ebebeb

set $Scripts ~/.my_scripts/.data
set $Locker ~/.my_scripts/.data/sway_start_lockscreen.sh

set $Font Hack 9


##
# Font
##

font pango:$Font


##
# Mode setup
##

set $LCD eDP-1
# --reload: correct state after "reload" too, --locked: works on the lock screen
bindswitch --reload --locked lid:on output $LCD disable
bindswitch --reload --locked lid:off output $LCD enable

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# disable follow focus by mouse
focus_follows_mouse no

# Enable border only when have more than one window
default_border pixel 1
default_floating_border none
hide_edge_borders smart

gaps inner 10


##
# Color scheme
##

# window colors
#                       border              background         text                 indicator
# client.focused          $bg-color           #ff3300            $text-color          #00ff00
# #client.focused          $bg-color           $bg-color          $text-color          #00ff00
# client.unfocused        $inactive-bg-color  $inactive-bg-color $inactive-text-color #00ff00
# client.focused_inactive $inactive-bg-color  $inactive-bg-color $inactive-text-color #00ff00
# client.urgent           $urgent-bg-color    $urgent-bg-color   $text-color          #00ff00


##
# System shortcuts
##

# start a terminal
bindsym --to-code Ctrl+Mod1+t exec alacritty

# kill focused window
bindsym --to-code Ctrl+Shift+q kill

# application launcher. The old -width/-lines/-color-* flags were removed
# from rofi; the look now lives in ~/.config/rofi/config.rasi
bindsym --to-code Mod1+F2 exec rofi -show drun
bindsym --to-code $mod+d exec rofi -show drun
# run any command / switch between open windows
bindsym --to-code $mod+Shift+d exec rofi -show run
bindsym --to-code Mod1+Tab exec rofi -show window
# docker apps: start / stop the containers from ~/.config/docker/dockerfunc
bindsym --to-code $mod+c exec $Scripts/rofi_docker_menu.sh


# Make the currently focused window a scratchpad
bindsym --to-code $mod+Shift+minus move scratchpad
# Show the first scratchpad window
bindsym --to-code $mod+minus scratchpad show

# change focus
bindsym --to-code $mod+j focus left
bindsym --to-code $mod+k focus down
bindsym --to-code $mod+i focus up
bindsym --to-code $mod+l focus right

# move focused window
bindsym --to-code $mod+Shift+j move left
bindsym --to-code $mod+Shift+k move down
bindsym --to-code $mod+Shift+i move up
bindsym --to-code $mod+Shift+l move right

# move workspace
bindsym --to-code $mod+Ctrl+Shift+j move workspace to output left
bindsym --to-code $mod+Ctrl+Shift+l move workspace to output right

# split in horizontal orientation
bindsym --to-code $mod+h split h
# split in vertical orientation
bindsym --to-code $mod+v split v

# enter fullscreen mode for the focused container
bindsym --to-code $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split) bindsym $mod+s layout stacking
bindsym --to-code $mod+w layout tabbed
bindsym --to-code $mod+e layout toggle split

# toggle tiling / floating
bindsym --to-code $mod+Shift+space floating toggle

# change focus between tiling / floating windows
# ($mod+space is the keyboard layout switch, xkb_options grp:win_space_toggle,
#  so binding it here made Win+Space switch layout AND jump focus)
bindsym --to-code $mod+Tab focus mode_toggle

# switch to workspace
bindsym --to-code $mod+1 workspace $wspace1
bindsym --to-code $mod+2 workspace $wspace2
bindsym --to-code $mod+3 workspace $wspace3
bindsym --to-code $mod+4 workspace $wspace4
bindsym --to-code $mod+5 workspace $wspace5
bindsym --to-code $mod+6 workspace $wspace6
bindsym --to-code $mod+7 workspace $wspace7
bindsym --to-code $mod+8 workspace $wspace8
bindsym --to-code $mod+9 workspace $wspace9
bindsym --to-code $mod+0 workspace $wspace10

# move focused container to workspace
bindsym --to-code $mod+Shift+1 move container to workspace $wspace1
bindsym --to-code $mod+Shift+2 move container to workspace $wspace2
bindsym --to-code $mod+Shift+3 move container to workspace $wspace3
bindsym --to-code $mod+Shift+4 move container to workspace $wspace4
bindsym --to-code $mod+Shift+5 move container to workspace $wspace5
bindsym --to-code $mod+Shift+6 move container to workspace $wspace6
bindsym --to-code $mod+Shift+7 move container to workspace $wspace7
bindsym --to-code $mod+Shift+8 move container to workspace $wspace8
bindsym --to-code $mod+Shift+9 move container to workspace $wspace9
bindsym --to-code $mod+Shift+0 move container to workspace $wspace10

# reload sway config (waybar reloads style.css by itself)
bindsym --to-code $mod+Shift+r reload
# power menu: lock / suspend / log out / reboot / power off (asks to confirm)
# uses your rofi theme "power" if it exists
bindsym --to-code $mod+Shift+e exec $Scripts/sway_power_menu.sh

mode "resize" {
        bindsym --to-code j resize shrink width 10 px or 10 ppt
        bindsym --to-code k resize grow height 10 px or 10 ppt
        bindsym --to-code i resize shrink height 10 px or 10 ppt
        bindsym --to-code l resize grow width 10 px or 10 ppt

        bindsym --to-code Left resize shrink width 1 px or 1 ppt
        bindsym --to-code Down resize grow height 1 px or 1 ppt
        bindsym --to-code Up resize shrink height 1 px or 1 ppt
        bindsym --to-code Right resize grow width 1 px or 1 ppt

        bindsym --to-code Return mode "default"
        bindsym --to-code Escape mode "default"
}

bindsym --to-code $mod+r mode "resize"

# bars: show / hide both (works even if the bar is not running)
bindsym --to-code $mod+m exec ~/.config/sway/bar.sh toggle
# bars: restart (re-reads waybar.conf)
bindsym --to-code $mod+Shift+m exec ~/.config/sway/bar.sh restart


##
# Bar
# One waybar process draws both bars (top + bottom), see waybar.conf.
# Log: $XDG_RUNTIME_DIR/waybar.log
##

exec ~/.config/sway/bar.sh start

##
# Window association
# Get info: swaymsg -t get_tree
##
# Matches are regular expressions; (?i) = ignore case.
# Docker apps get the same app_id/class as the normal ones, so they land
# on the same workspace.

# 1 - browser
assign [app_id="(?i)firefox"] $wspace1
assign [class="(?i)firefox"] $wspace1
assign [app_id="(?i)waterfox"] $wspace1
assign [class="(?i)waterfox"] $wspace1

# 2 - terminal
assign [app_id="Alacritty"] $wspace2
assign [app_id="termite"] $wspace2

# 3 - editors: Neovim (alacritty --class nvim), Sublime, other text editors
assign [app_id="^nvim$"] $wspace3
assign [app_id="^neovide$"] $wspace3
assign [class="(?i)sublime_text"] $wspace3
assign [app_id="(?i)sublime_text"] $wspace3
assign [app_id="^org\.gnome\.(TextEditor|gedit)$"] $wspace3
assign [app_id="^org\.xfce\.mousepad$"] $wspace3
assign [app_id="^org\.kde\.kate$"] $wspace3
assign [app_id="^(code|code-oss)$"] $wspace3
assign [class="^(Code|code-oss)$"] $wspace3
assign [class="jetbrains-idea"] $wspace3
# docker nvimcpp / nvimide terminals
assign [app_id="^docker-nvim"] $wspace3

# 4 - Steam (docker)
assign [class="(?i)^steam$"] $wspace4

# 5 - Chromium (docker)
assign [app_id="^chromium$"] $wspace5
assign [class="^Chromium$"] $wspace5

# 6 - file manager
assign [app_id="(?i)^pcmanfm"] $wspace6
assign [class="(?i)^pcmanfm"] $wspace6

# 7 - mail
assign [app_id="(?i)thunderbird"] $wspace7
assign [class="(?i)thunderbird"] $wspace7
assign [app_id="^org\.gnome\.Geary$"] $wspace7

# 8 - Claude: desktop app, or the Claude web app window (docker "claude")
assign [app_id="(?i)claude"] $wspace8
assign [class="(?i)claude"] $wspace8

# 9 - chat: Telegram, Discord
assign [app_id="org.telegram.desktop"] $wspace9
assign [class="(?i)telegram"] $wspace9
assign [class="(?i)discord"] $wspace9

# 10 - video editing: Kdenlive (also DaVinci Resolve, Shotcut)
assign [app_id="^org\.kde\.kdenlive$"] $wspace10
assign [class="(?i)^resolve$"] $wspace10
assign [app_id="^org\.shotcut\.Shotcut$"] $wspace10

for_window [app_id="gnome-calculator"] floating enable
for_window [class="Tor Browser"] floating enable
for_window [class="VirtualBox Manager"] floating enable
for_window [class="VirtualBox Machine"] floating enable
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
# terminal popups started from waybar (network / bluetooth click)
for_window [app_id="nmtui"] floating enable, resize set 760 520
for_window [app_id="bluetoothctl"] floating enable, resize set 760 520
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

# Do not lock / turn off the screen while something is fullscreen (video, game)
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen


##
# Idle and power saving
#   4 min   - dim the screen (any input restores brightness)
#   5 min   - lock
#   5.5 min - screen off
#   15 min  - suspend, only when running on battery
# The screen is always locked before suspend.
# The eye button in waybar (idle inhibitor) turns all of this off.
##

exec swayidle -w \
    timeout 240 'brightnessctl -q -s set 10%' resume 'brightnessctl -q -r' \
    timeout 300 '~/.my_scripts/.data/sway_start_lockscreen.sh' \
    timeout 330 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    timeout 900 '~/.my_scripts/.data/sway_suspend_on_battery.sh' \
    before-sleep '~/.my_scripts/.data/sway_start_lockscreen.sh'


##
# Custom autostart
##

# Hack as the UI font of GTK apps too (file dialogs, pavucontrol, ...)
exec gsettings set org.gnome.desktop.interface font-name 'Hack 10'
exec gsettings set org.gnome.desktop.interface monospace-font-name 'Hack 10'

# notifications (settings: ~/.config/mako/config)
exec mako
# low battery notifications at 15% and 5%
exec $Scripts/sway_battery_notify.sh 15 5
exec ~/.my_scripts/.data/binary/sway_independent_layouts/sway_independent_layouts


##
# Custom shortcut
##

# notifications: dismiss all / restore last / do not disturb
bindsym --to-code Ctrl+Shift+space exec makoctl dismiss -a
bindsym --to-code $mod+Shift+n exec makoctl restore
bindsym --to-code $mod+n exec $Scripts/sway_dnd_toggle.sh

# lockscreen and suspend (swayidle locks before sleep by itself)
bindsym --to-code Ctrl+Mod1+Shift+l exec $Locker
bindsym --to-code Ctrl+Mod1+Shift+s exec systemctl suspend

# media keys (waybar updates by itself, no signals needed)
# --locked: the keys also work on the lock screen
bindsym --locked XF86AudioRaiseVolume exec pamixer -i 5
bindsym --locked XF86AudioLowerVolume exec pamixer -d 5
bindsym --locked XF86AudioMute exec pamixer -t
bindsym --locked XF86AudioMicMute exec pamixer --default-source -t

# Player controls
bindsym --to-code Ctrl+space exec mpc -q toggle
bindsym --to-code Ctrl+Prior exec mpc -q prev
bindsym --to-code Ctrl+Next exec mpc -q next

bindsym --locked XF86AudioPlay exec mpc -q toggle
bindsym --locked XF86AudioPrev exec mpc -q prev
bindsym --locked XF86AudioNext exec mpc -q next

# Screen brightness (5% steps, never completely black)
# Add user to 'video' group
bindsym --locked XF86MonBrightnessUp exec brightnessctl -q set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl -q -n1 set 5%-

# screenshot
bindsym --to-code --release F12 exec $Scripts/sway_make_screenshot.sh
bindsym --to-code --release Shift+F12 exec $Scripts/sway_make_screenshot.sh -a
bindsym --to-code --release Ctrl+F12 exec $Scripts/sway_make_screenshot.sh -r



##
# Setup input and output
# Get info: swaymsg -t get_outputs
##

output "*" bg ~/.wallpapers/wallpaper.png fill
#output X11-1 resolution 1920x1080 position 1920,0
# Outputs must not overlap: eDP-1 at x=2256 is 2256 px wide (2256..4512),
# so DP-5 at x=2560 was on top of it. Laptop left, monitor right:
output eDP-1 resolution 2256x1504 position 0,0
output DP-5 resolution 2560x1440 position 2256,0
# Monitor on the left instead? Use: DP-5 position 0,0 / eDP-1 position 2560,0
# Text too small on the laptop panel? Try: output eDP-1 scale 1.5

input type:touchpad {
    # tap to click, ignore the touchpad while typing
    tap enabled
    dwt enabled
    #natural_scroll enabled
}

input type:keyboard {
    # Enable NumLock on startup
    #xkb_numlock enabled
    xkb_layout "us,ru"
    xkb_options "grp:win_space_toggle"
}


##
# System defaults from the sway package: exports WAYLAND_DISPLAY/SWAYSOCK
# to systemd and D-Bus (screen sharing, portals, tray apps, notifications)
##

include /etc/sway/config.d/*
