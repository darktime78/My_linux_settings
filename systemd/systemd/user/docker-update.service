[Unit]
Description=Update Docker images (rebuild ~/.my_scripts/docker_images, pull registry images)
Documentation=file://%h/.my_scripts/docker_images/update.sh
# Rebuilding images takes a while and uses the CPU: never on battery.
# On battery the run is skipped; the daily timer tries again the next day.
ConditionACPower=true

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.my_scripts/docker_images/update.sh --auto
# stay out of the way
Nice=19
CPUWeight=20
IOSchedulingClass=idle
TimeoutStartSec=4h
