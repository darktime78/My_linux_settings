/*
 * rofi launcher (rofi >= 1.7, native Wayland since 2.0).
 * The old command line colour options (-color-window, -width, -lines ...)
 * were removed from rofi, so the look now lives here.
 */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    font: "Cantarell 13";
    drun-display-format: "{name}";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    matching: "fuzzy";
    sort: true;
}

* {
    bg:     #2f343ff2;
    bg-alt: #3b4049;
    fg:     #ebebeb;
    dim:    #8a8f96;
    accent: #005577;

    background-color: transparent;
    text-color:       @fg;
}

window {
    location:         north;
    anchor:           north;
    y-offset:         80px;
    width:            560px;
    background-color: @bg;
    border-radius:    12px;
    padding:          12px;
}

mainbox {
    spacing: 10px;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          10px;
    padding:          8px 10px;
    background-color: @bg-alt;
    border-radius:    8px;
}

prompt {
    text-color: @dim;
}

entry {
    placeholder:       "Type to search";
    placeholder-color: @dim;
}

listview {
    lines:        8;
    fixed-height: false;
    scrollbar:    false;
    spacing:      2px;
}

element {
    padding:       6px 10px;
    spacing:       10px;
    border-radius: 6px;
}

element selected.normal {
    background-color: @accent;
}

element-icon {
    size:             1.3em;
    background-color: inherit;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}

message {
    padding: 6px 10px;
}
